---
import { topicName } from "../lib/topics";

interface Props {
  topics: readonly string[];
}

const { topics } = Astro.props;
---

<ul class="flex flex-wrap gap-2">
  {
    topics.map((topic) => (
      <li>
        <a
          class="inline-block rounded-full border-edge text-ink hover:border-ink-muted hover:text-ink-strong border px-3 py-1 text-sm"
          href={`/topics/${topic}/`}
        >
          {topicName(topic)}
        </a>
      </li>
    ))
  }
</ul>
