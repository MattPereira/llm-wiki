---
import { getCollection } from "astro:content";
import BrowseList from "../../components/BrowseList.astro";
import Base from "../../layouts/Base.astro";
import { summaryCount } from "../../lib/format";
import { byTopic } from "../../lib/summaries";
import { topicName, topicSlugs } from "../../lib/topics";

// Driven by topics.toml, not by what Summaries happen to carry: a reader should
// see the whole vocabulary before searching for something the wiki has nothing on.
const grouped = byTopic(await getCollection("summaries"));

const items = topicSlugs().map((slug) => {
  const count = grouped.get(slug)?.length ?? 0;
  return {
    href: `/topics/${slug}/`,
    name: topicName(slug),
    note: count === 0 ? "Nothing yet" : summaryCount(count),
  };
});
---

<Base
  title="Topics — Market Wiki"
  description="The whole topic vocabulary the wiki uses."
>
  <h1 class="sr-only">Topics</h1>
  <BrowseList items={items} />
</Base>
