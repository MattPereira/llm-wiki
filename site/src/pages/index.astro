---
import { getCollection } from "astro:content";
import SummaryList from "../components/SummaryList.astro";
import Base from "../layouts/Base.astro";
import { newestFirst } from "../lib/summaries";

const summaries = newestFirst(await getCollection("summaries"));
---

<Base
  title="Market Wiki"
  description="Summaries of the things worth reading, written by an agent."
>
  <header class="mb-12">
    <h1
      class="font-serif text-4xl font-semibold tracking-tight text-stone-900 dark:text-stone-100"
    >
      Market Wiki
    </h1>
    <p class="mt-2 text-stone-600 dark:text-stone-400">
      Summaries of the things worth reading, so you can decide what to open.
    </p>
  </header>

  <SummaryList summaries={summaries} />
</Base>
