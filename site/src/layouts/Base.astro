---
interface Props {
  title: string;
  description?: string;
}

import "../styles/global.css";

const { title, description } = Astro.props;

const linkClass =
  "text-stone-500 hover:text-stone-900 dark:text-stone-500 dark:hover:text-stone-100";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" href="data:," />
    <slot name="head" />
  </head>
  <body
    class="bg-white text-lg text-stone-800 antialiased dark:bg-stone-950 dark:text-stone-300"
  >
    <div class="mx-auto max-w-4xl px-5 py-10 sm:px-6 sm:py-16">
      <nav
        class="mb-10 flex gap-5 border-b border-stone-200 pb-4 text-base dark:border-stone-800"
        data-pagefind-ignore
      >
        <a class={linkClass} href="/">Summaries</a>
        <a class={linkClass} href="/creators/">Creators</a>
        <a class={linkClass} href="/topics/">Topics</a>
        <a class={linkClass} href="/search/">Search</a>
      </nav>
      <slot />
    </div>
  </body>
</html>
