---
/** The /creators and /topics index shape: a name to click and a line about it. */
export interface BrowseItem {
  href: string;
  name: string;
  note: string;
}

interface Props {
  items: BrowseItem[];
}

const { items } = Astro.props;
---

<ul class="divide-edge divide-y">
  {
    items.map((item) => (
      <li class="py-5 first:pt-0">
        <a class="group block" href={item.href}>
          <h2 class="font-serif text-2xl font-semibold text-ink-strong group-hover:decoration-ink-muted group-hover:underline group-hover:underline-offset-4">
            {item.name}
          </h2>
          <p class="mt-1 max-w-[70ch] text-ink-muted text-base">{item.note}</p>
        </a>
      </li>
    ))
  }
</ul>
