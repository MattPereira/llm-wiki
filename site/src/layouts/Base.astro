---
interface Props {
  title: string;
  description?: string;
}

import { activeNav } from "../lib/nav";
import "../styles/global.css";

const { title, description } = Astro.props;

const active = activeNav(Astro.url.pathname);

const links = [
  { href: "/", label: "Summaries" },
  { href: "/creators/", label: "Creators" },
  { href: "/topics/", label: "Topics" },
  { href: "/search/", label: "Search" },
];
---

<!doctype html>
<html lang="en" data-theme="system">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" href="data:," />
    <link
      rel="preload"
      href="/fonts/inter-latin-400-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/source-serif-4-latin-600-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <script is:inline>
      // Blocking on purpose: both the palette and the toggle label have to be
      // settled before first paint, or the page flashes the wrong theme.
      (() => {
        let stored = null;
        try {
          stored = localStorage.getItem("theme");
        } catch {
          // Storage can throw when cookies are blocked; system default is fine.
        }
        const theme = stored === "light" || stored === "dark" ? stored : "system";
        document.documentElement.dataset.theme = theme;
        if (theme !== "system") document.documentElement.style.colorScheme = theme;
      })();
    </script>
    <slot name="head" />
  </head>
  <body class="bg-surface text-ink text-lg antialiased">
    <div class="mx-auto max-w-4xl px-5 py-10 sm:px-6 sm:py-16">
      <nav
        class="border-edge mb-10 flex gap-5 border-b text-base"
        data-pagefind-ignore
      >
        {
          links.map(({ href, label }) => (
            <a
              class:list={[
                "-mb-px border-b-2 pb-4",
                href === active
                  ? "border-ink-strong text-ink-strong font-medium"
                  : "text-ink-muted hover:text-ink-strong border-transparent",
              ]}
              href={href}
              aria-current={href === active ? "page" : undefined}
            >
              {label}
            </a>
          ))
        }
        <button
          class="text-ink-muted hover:text-ink-strong ml-auto pb-4 text-base"
          id="theme-toggle"
          type="button"
        >
          <span class="sr-only">Theme:</span>
          <span data-theme-label="system">Auto</span>
          <span data-theme-label="light">Light</span>
          <span data-theme-label="dark">Dark</span>
        </button>
      </nav>
      <slot />
    </div>
    <script is:inline>
      document.getElementById("theme-toggle").addEventListener("click", () => {
        const root = document.documentElement;
        const order = ["system", "light", "dark"];
        const next = order[(order.indexOf(root.dataset.theme) + 1) % order.length];

        root.dataset.theme = next;
        root.style.colorScheme = next === "system" ? "" : next;

        try {
          if (next === "system") localStorage.removeItem("theme");
          else localStorage.setItem("theme", next);
        } catch {
          // Preference just won't survive the reload.
        }
      });
    </script>
  </body>
</html>
