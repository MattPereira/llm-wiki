---
interface Props {
  title: string;
  description?: string;
}

import { activeNav } from "../lib/nav";
import "../styles/global.css";

const { title, description } = Astro.props;

const active = activeNav(Astro.url.pathname);

const links = [
  { href: "/", label: "Summaries" },
  { href: "/creators/", label: "Creators" },
  { href: "/topics/", label: "Topics" },
  { href: "/search/", label: "Search" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" href="data:," />
    <slot name="head" />
  </head>
  <body
    class="bg-white text-lg text-stone-800 antialiased dark:bg-stone-950 dark:text-stone-300"
  >
    <div class="mx-auto max-w-4xl px-5 py-10 sm:px-6 sm:py-16">
      <nav
        class="mb-10 flex gap-5 border-b border-stone-200 text-base dark:border-stone-800"
        data-pagefind-ignore
      >
        {
          links.map(({ href, label }) => (
            <a
              class:list={[
                "-mb-px border-b-2 pb-4",
                href === active
                  ? "border-stone-800 font-medium text-stone-900 dark:border-stone-300 dark:text-stone-100"
                  : "border-transparent text-stone-500 hover:text-stone-900 dark:text-stone-500 dark:hover:text-stone-100",
              ]}
              href={href}
              aria-current={href === active ? "page" : undefined}
            >
              {label}
            </a>
          ))
        }
      </nav>
      <slot />
    </div>
  </body>
</html>
